# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local (gitignored) and fill in real values.
# Never commit a filled-in copy. Everything here except STRIPE_MODE, APP_URL and
# PORTAL_DEMO_MODE is a secret or an account-specific id.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard > Project Settings > Data API > "Project URL".
#
# MUST be the bare project URL. Do NOT append /rest/v1 — this code appends its
# own API prefix, so a value ending in /rest/v1 builds /rest/v1/rest/v1/... and
# PostgREST rejects EVERY request with PGRST125. The app corrects this in memory
# and prints a loud banner at boot, but fix the value here.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard > Project Settings > API Keys > Secret keys.
# The sb_secret_* key (formerly service_role). SERVER ONLY: it bypasses RLS.
# Never expose this to browser code, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Portal ------------------------------------------------------------------
# The email that is bootstrapped as the portal admin on its first magic-link
# sign-in. Set this BEFORE signing in for the first time — there is no hardcoded
# fallback, and without it no account becomes admin.
PORTAL_ADMIN_EMAIL=you@yourstudio.com

# The portal's own origin. Used to build the magic-link redirect, so a wrong
# value sends clients to the wrong host. On Vercel this falls back to VERCEL_URL.
APP_URL=http://localhost:3000

# Serves the built-in demo dataset instead of the database, for showing the
# portal to prospects. Never set this to true on a deployment holding real
# client data — see docs/CUSTOMIZING.md.
PORTAL_DEMO_MODE=false

# --- Stripe ------------------------------------------------------------------
# "test" or "live". Defaults to test when unset, so a deployment that forgets
# this cannot accidentally take a real payment.
#
# The key prefix must MATCH this mode: STRIPE_MODE=test requires sk_test_, and
# STRIPE_MODE=live requires sk_live_. A mismatch throws at the first call rather
# than quietly charging somebody — or quietly not charging them.
STRIPE_MODE=test

# Stripe dashboard (matching the mode above) > Developers > API keys > Secret key.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Local runs: the whsec_* line printed by `stripe listen --forward-to ...`.
# Deployed: Stripe dashboard > Developers > Webhooks > your endpoint > Signing
# secret. These are DIFFERENT values — do not reuse the deployed one locally.
#
# Without this the webhook answers 503, no invoice is ever marked paid, and
# handoff can never unlock. See docs/STRIPE_SETUP.md.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Optional. Recurring price id for the care plan subscription. Stripe dashboard >
# Product catalogue > your care plan product > Pricing > the price's API id.
# Used as the fallback when the admin care-plan route is called without one.
STRIPE_CARE_PRICE_ID=

# --- Email notifications (optional) ------------------------------------------
# With RESEND_API_KEY unset, the portal skips sending mail and everything else
# still works. Clients still get Supabase's magic-link email either way.
RESEND_API_KEY=
# Sender address. Must be a resend.com/domains verified domain, or
# onboarding@resend.dev for testing.
NOTIFY_FROM_EMAIL=
