{
  "name": "client-portal-template",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable premium client portal template — Next.js, Supabase, Stripe.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
